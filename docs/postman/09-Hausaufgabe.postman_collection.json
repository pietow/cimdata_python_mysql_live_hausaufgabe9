{
  "info": {
    "name": "Tag9 – Hausaufgabe Hogwarts",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Reihenfolge einhalten. Vom Seeder erzeugte lokale Umgebung auswählen. Keine Fachdatensätze werden verändert."
  },
  "item": [
    {
      "name": "Anmelden: mcgonagall",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"mcgonagall\", \"password\": \"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.environment.set('staff_token', pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
